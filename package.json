{
  "name": "sylistly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "catalog:build": "node --experimental-strip-types --env-file=.env.local scripts/build-photo-catalog.mts",
    "catalog:hydrate-links": "node --experimental-strip-types --env-file=.env.local scripts/hydrate-photo-catalog-urls.mts",
    "catalog:expand": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/expand-catalog.ts",
    "catalog:ingest-drops": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/ingest-new-drops.ts",
    "catalog:import-searchapi-quality": "node --experimental-strip-types scripts/import-searchapi-quality-catalog.ts",
    "catalog:client": "jiti scripts/build-client-catalog.ts",
    "feed:generate-ai": "node scripts/generate-ai-feed.mjs",
    "catalog:refresh": "npm run catalog:ingest-drops -- --apply && npm run catalog:client",
    "catalog:enrich": "jiti scripts/enrich-catalog-tags.ts",
    "catalog:vision": "jiti scripts/analyze-catalog-vision.ts --apply",
    "catalog:validate": "jiti scripts/validate-catalog.ts",
    "catalog:audit-images": "jiti scripts/audit-product-images.ts",
    "catalog:test-search": "jiti scripts/test-catalog-search.ts",
    "catalog:test-generator": "jiti scripts/test-generator-variety.ts",
    "seed:catalog": "node --experimental-strip-types --env-file=.env.local scripts/seed-brand-catalog.mts",
    "smoke:search": "node --env-file=.env.local scripts/smoke-search.mjs",
    "smoke:search:direct": "node --experimental-strip-types --env-file=.env.local scripts/direct-search-smoke.mjs",
    "smoke:routes": "jiti scripts/check-route-smoke.ts",
    "test:units": "jiti scripts/check-lib-units.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:units && npm run smoke:routes",
    "library:generate": "node scripts/generate-outfit-library.mjs",
    "auto:expand": "node scripts/auto-expand.mjs",
    "auto:ship": "node scripts/auto-expand-ship.mjs",
    "bake:ai": "node scripts/bake-ai-looks.mjs",
    "bake:ship": "node scripts/bake-ai-ship.mjs",
    "test:frame": "node scripts/test-frame-constraint.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/three": "^0.180.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.462.0",
    "next": "15.5.15",
    "posthog-js": "^1.181.0",
    "postprocessing": "^6.39.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
