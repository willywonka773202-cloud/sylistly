{
  "name": "sylistly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "bertos:daemon": "node scripts/daemon.mjs",
    "bertos:cli": "node cli/bertos.mjs",
    "bertos:doctor": "node cli/bertos.mjs doctor",
    "bertos:status": "node cli/bertos.mjs status",
    "catalog:build": "node --experimental-strip-types --env-file=.env.local scripts/build-photo-catalog.mts",
    "catalog:hydrate-links": "node --experimental-strip-types --env-file=.env.local scripts/hydrate-photo-catalog-urls.mts",
    "catalog:expand": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/expand-catalog.ts",
    "catalog:enrich": "jiti scripts/enrich-catalog-tags.ts",
    "catalog:validate": "jiti scripts/validate-catalog.ts",
    "catalog:audit-images": "jiti scripts/audit-product-images.ts",
    "catalog:test-search": "jiti scripts/test-catalog-search.ts",
    "catalog:test-generator": "jiti scripts/test-generator-variety.ts",
    "seed:catalog": "node --experimental-strip-types --env-file=.env.local scripts/seed-brand-catalog.mts",
    "smoke:search": "node --env-file=.env.local scripts/smoke-search.mjs",
    "smoke:search:direct": "node --experimental-strip-types --env-file=.env.local scripts/direct-search-smoke.mjs",
    "bertos:safety": "node -e \"const {execSync}=require('child_process');const r=execSync('git remote get-url origin',{encoding:'utf8'}).trim();if(r.toLowerCase().includes('sylistly')){console.error('SAFETY FAIL: repo remote contains sylistly:',r);process.exit(1);}console.log('Safety OK: remote is',r);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.11.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.462.0",
    "next": "15.5.15",
    "openai": "^6.38.0",
    "posthog-js": "^1.181.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
