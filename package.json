{
  "name": "sylistly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "catalog:build": "node --experimental-strip-types --env-file=.env.local scripts/build-photo-catalog.mts",
    "catalog:hydrate-links": "node --experimental-strip-types --env-file=.env.local scripts/hydrate-photo-catalog-urls.mts",
    "catalog:expand": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/expand-catalog.ts",
    "catalog:ingest-drops": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/ingest-new-drops.ts",
    "catalog:import-searchapi-quality": "node --experimental-strip-types scripts/import-searchapi-quality-catalog.ts",
    "catalog:client": "jiti scripts/build-client-catalog.ts",
    "feed:generate-ai": "node scripts/generate-ai-feed.mjs",
    "drop:library": "node scripts/generate-drop-look-library.mjs",
    "catalog:refresh": "npm run catalog:ingest-drops -- --apply && npm run catalog:client",
    "catalog:enrich": "jiti scripts/enrich-catalog-tags.ts",
    "catalog:vision": "jiti scripts/analyze-catalog-vision.ts --apply",
    "catalog:validate": "jiti scripts/validate-catalog.ts",
    "catalog:audit-images": "jiti scripts/audit-product-images.ts",
    "catalog:test-search": "jiti scripts/test-catalog-search.ts",
    "catalog:test-generator": "jiti scripts/test-generator-variety.ts",
    "seed:catalog": "node --experimental-strip-types --env-file=.env.local scripts/seed-brand-catalog.mts",
    "smoke:search": "node --env-file=.env.local scripts/smoke-search.mjs",
    "smoke:search:direct": "node --experimental-strip-types --env-file=.env.local scripts/direct-search-smoke.mjs",
    "smoke:routes": "jiti scripts/check-route-smoke.ts",
    "test:units": "jiti scripts/check-lib-units.ts",
    "test:taste": "jiti scripts/check-taste-profile.ts",
    "test:catalog-reliability": "jiti scripts/check-catalog-reliability.ts",
    "test:catalog-flow": "jiti scripts/check-catalog-flow-acceptance.ts",
    "test:catalog-worker": "jiti scripts/check-catalog-worker-persistence.ts",
    "test:catalog-analytics": "jiti scripts/check-catalog-analytics.ts",
    "test:style-owned": "node scripts/run-style-from-url-tests.cjs",
    "test:attribution": "jiti scripts/check-attribution.ts",
    "test:public-share": "jiti scripts/check-public-share-contract.ts",
    "test:performance": "node scripts/check-route-bundles.mjs",
    "test:performance:unit": "node --test scripts/check-route-bundles.test.mjs",
    "test:budget": "node scripts/check-budget-cap.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:units && npm run test:taste && npm run test:catalog-reliability && npm run test:catalog-flow && npm run test:catalog-worker && npm run test:catalog-analytics && npm run test:style-owned && npm run test:attribution && npm run test:public-share && npm run test:performance:unit && npm run test:budget && npm run test:outfit-library && npm run test:frame && npm run test:shoppability && npm run smoke:routes",
    "library:generate": "node scripts/generate-outfit-library.mjs",
    "test:outfit-library": "node scripts/check-outfit-library.mjs",
    "auto:expand": "node scripts/auto-expand.mjs",
    "auto:ship": "node scripts/auto-expand-ship.mjs",
    "bake:ai": "node scripts/bake-ai-looks.mjs",
    "bake:ship": "node scripts/bake-ai-ship.mjs",
    "test:frame": "node scripts/test-frame-constraint.mjs",
    "health:sweep": "node scripts/check-link-health.mjs",
    "test:shoppability": "node scripts/check-shoppability.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/three": "^0.180.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.462.0",
    "next": "15.5.15",
    "posthog-js": "^1.181.0",
    "postprocessing": "^6.39.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "jiti": "^1.21.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
