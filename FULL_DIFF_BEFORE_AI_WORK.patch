+      : undefined,
+    bag: items.bag ? resolveBagPlacement(items.bag, bagLayer) : undefined,
+    shoes: items.shoes
+      ? {
+          x: 50,
+          y: 88,
+          w: 42,
+          h: 10,
+          z: 8,
+          imageClassName: 'h-full w-full object-contain object-bottom',
+          blend: false,
+        }
+      : undefined,
