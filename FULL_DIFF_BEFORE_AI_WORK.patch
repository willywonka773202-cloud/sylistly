+      warnings.push(`${product.category} hard-avoids "${term}" for ${vibe}`);
+    }
+    for (const term of matchedTerms(haystack, rule.avoid)) {
+      warnings.push(`${product.category} avoids "${term}" for ${vibe}`);
+    }
+  }
+
+  return Array.from(new Set(warnings));
+}
