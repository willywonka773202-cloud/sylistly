+                renderableProduct ? 'bg-[linear-gradient(180deg,#fffdf9_0%,#efe5dc_100%)] ring-1 ring-[#eadfd5]' : 'bg-[#efe5dc]'
+              }`}
+              >
+                {renderableProduct ? (
