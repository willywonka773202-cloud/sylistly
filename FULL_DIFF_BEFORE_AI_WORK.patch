+                renderableProduct
+                  ? 'border-[#eadfd5] bg-[#f8f3ed] text-[#1b1714] shadow-[0_14px_30px_rgba(0,0,0,.24)]'
+                  : 'border-[#eadfd5] bg-[#f8f3ed] text-[#1b1714] hover:border-accent/50'
+              }`}
+            >
