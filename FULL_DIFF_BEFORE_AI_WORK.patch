+function scoreMatch(p: Product, q: string): number {
+  const hay = `${p.brand} ${p.name}`.toLowerCase();
+  return q.split(/\s+/).reduce((acc, t) => (hay.includes(t) ? acc + 10 : acc), 0);
+}
