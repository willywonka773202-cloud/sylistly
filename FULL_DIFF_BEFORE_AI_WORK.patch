+              vibeSearchQuery(vibeId, slot, generatorBudget, generatorFrame, customBudgetCents),
+              Array.from(new Set([
+                ...recentGeneratedIds,
+                ...(mode === 'starter' || mode === 'refresh' || mode === 'full' ? currentProductIds : []),
