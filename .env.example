# ============================================================
# BertOS — AI Operating System
# Copy to .env.local and fill in values
# ============================================================

# ===== DEPLOYMENT MODE =====
# Auto-detected: "cloud" on Vercel, "local" for dev
BERTOS_DEPLOYMENT_MODE=local
BERTOS_DAEMON_PORT=3001
# Secret for CLI / agent API access (leave blank = dev mode, no auth)
BERTOS_AGENT_SECRET=

# ===== OLLAMA (PRIMARY — ALWAYS-ON) =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gpt-oss:120b-cloud
OLLAMA_LOCAL_FALLBACK=qwen2.5-coder:latest
# Cloud/Vercel: get from ollama.com/settings/api-keys
OLLAMA_API_KEY=

# ===== OPTIONAL API PROVIDERS =====
# Disabled by default. Separate metered billing — NOT included in subscriptions.
ENABLE_API_PROVIDERS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== HERMES AGENT (OPTIONAL — SELF-HOSTED) =====
HERMES_API_URL=
HERMES_API_KEY=

# ===== COMPOSIO TOOLS (OPTIONAL) =====
COMPOSIO_API_KEY=

# ===== CORE =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== SEARCH =====
SEARCHAPI_KEY=
SEARCH_MODE=catalog-only

# ===== AFFILIATE =====
SKIMLINKS_PUBLISHER_ID=
RAKUTEN_AFFILIATE_ID=

# ===== ANALYTICS =====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===== STORAGE =====
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=bertos-files
CLOUDFLARE_R2_ENDPOINT=
NEXT_PUBLIC_CDN_URL=

# ===== STRIPE =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== APP =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
