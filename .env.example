# Copy to .env.local and fill in

# ===== CORE =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
SEARCHAPI_KEY=
SEARCH_MODE=catalog-only

# ===== AI MODELS =====
# Outfit composer (the builder) — Haiku by default for speed + low cost.
OUTFIT_COMPOSER_MODEL=claude-haiku-4-5
# Abort remote composition quickly and fall back to the local engine (3-25s).
OUTFIT_COMPOSER_TIMEOUT_MS=10000
# Optional feed enhancement. Keep off unless the configured model is verified;
# complete catalog-backed looks still work without it.
NEXT_PUBLIC_ENABLE_LIVE_AI_LOOKS=0
# Syli chat model.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Search intent + rerank model (highest-volume path → cheap model).
CLAUDE_SEARCH_MODEL=claude-haiku-4-5

# ===== AI COST GUARDRAILS =====
# Hard kill switch: set to 0/false/off to disable ALL paid AI (free engine only).
AI_ENABLED=1
# Approx daily spend ceiling in USD (UTC day). 0 or blank = no cap. When reached,
# every AI path falls back to the free deterministic engine until the next day.
# NOTE: enforced in-memory per server instance — for an exact global cap across
# many instances, back lib/ai-budget.ts with a shared store (Upstash/Supabase).
AI_DAILY_USD_CAP=10
# Per-client (per-IP) AI calls allowed per rolling minute; excess degrades to free.
AI_RATELIMIT_PER_MIN=20

# ===== CATALOG VISION AI =====
# Vision classification should run during catalog/admin refreshes, not on every feed load.
# Free tiers are useful for beta/dev, but production should use a paid tier + caching.
CATALOG_VISION_ENABLED=0
CATALOG_VISION_PROVIDER=gemini
CATALOG_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
CATALOG_VISION_ADMIN_TOKEN=
CATALOG_VISION_MAX_IMAGE_BYTES=6000000

# Scheduled catalog refresh. Vercel Cron sends CRON_SECRET as a bearer token.
CRON_SECRET=
CATALOG_REFRESH_TOKEN=
CATALOG_REFRESH_LIMIT=120
CATALOG_REFRESH_SEARCHAPI=0
CATALOG_REFRESH_SEARCHAPI_MAX_QUERIES=0

# Internal catalog operations dashboard/API. Use long random server-only values.
CATALOG_OPS_TOKEN=
CATALOG_OPS_SESSION_SECRET=

# “Style what I own” product-page verification safety bounds. Both are optional;
# values are clamped server-side (timeout 1–10s, HTML 64KiB–1MiB).
STYLE_FROM_URL_TIMEOUT_MS=4500
STYLE_FROM_URL_MAX_HTML_BYTES=524288

# ===== AFFILIATE =====
SKIMLINKS_PUBLISHER_ID=
RAKUTEN_AFFILIATE_ID=

# ===== ANALYTICS =====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===== PHASE 2 =====
FASHN_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=sylistly-images
CLOUDFLARE_R2_ENDPOINT=
NEXT_PUBLIC_CDN_URL=https://cdn.sylistly.com

# ===== RUNTIME =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
