# Copy to .env.local and fill in

# ===== BertOS Provider Configuration =====

# Deployment mode (auto-detected from VERCEL env var if not set)
# Set to "cloud" in Vercel, "local" for local development
BERTOS_DEPLOYMENT_MODE=local

# Ollama configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gpt-oss:120b-cloud
OLLAMA_LOCAL_FALLBACK=qwen2.5-coder:latest

# Required for Vercel/cloud deployment ONLY:
# Get this key from your Ollama account at https://ollama.com
OLLAMA_API_KEY=

# ===== Optional API Providers =====
# DISABLED by default. These create separate metered billing.
# ChatGPT Plus / Claude Pro / Google One do NOT include API credits.
ENABLE_API_PROVIDERS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== CORE =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== SEARCH =====
SEARCHAPI_KEY=
SEARCH_MODE=catalog-only

# ===== AFFILIATE =====
SKIMLINKS_PUBLISHER_ID=
RAKUTEN_AFFILIATE_ID=

# ===== ANALYTICS =====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===== PHASE 2 =====
FASHN_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=sylistly-images
CLOUDFLARE_R2_ENDPOINT=
NEXT_PUBLIC_CDN_URL=https://cdn.sylistly.com

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
