# Copy to .env.local and fill in

# ===== CORE =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== BERTOS PROVIDER LAYER =====
# Ollama — defaults to http://127.0.0.1:11434 (local Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gpt-oss:120b-cloud
OLLAMA_LOCAL_FALLBACK=qwen2.5-coder:latest

# Optional API providers — DISABLED by default.
# Warning: these create a separate metered bill.
# ChatGPT Plus / Claude Pro / Google One do NOT include API credits.
ENABLE_API_PROVIDERS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

SEARCHAPI_KEY=
SEARCH_MODE=catalog-only

# ===== AFFILIATE =====
SKIMLINKS_PUBLISHER_ID=
RAKUTEN_AFFILIATE_ID=

# ===== ANALYTICS =====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===== PHASE 2 =====
FASHN_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=sylistly-images
CLOUDFLARE_R2_ENDPOINT=
NEXT_PUBLIC_CDN_URL=https://cdn.sylistly.com

# ===== RUNTIME =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
